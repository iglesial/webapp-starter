{
  "name": "webapp-starter",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "typecheck": "tsc -b --noEmit && tsc --noEmit -p amplify/tsconfig.json",
    "synth": "cdk synth --quiet --app \"npx tsx amplify/backend.ts\" --context amplify-backend-namespace=synthcheck --context amplify-backend-name=local --context amplify-backend-type=branch --context @aws-cdk/core:validateAgainstDefaultRules=true",
    "test:e2e": "playwright test"
  },
  "dependencies": {
    "@aws-amplify/ui-react": "^6.15.4",
    "@plausible-analytics/tracker": "^0.4.6",
    "aws-amplify": "^6.18.0",
    "i18next": "^26.4.2",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-i18next": "^17.0.15",
    "react-markdown": "^10.1.0",
    "react-router-dom": "^7.18.0",
    "remark-directive": "^4.0.0",
    "remark-gfm": "^4.0.1",
    "stripe": "^22.6.2",
    "unist-util-visit": "^5.1.0"
  },
  "devDependencies": {
    "@aws-amplify/backend": "^1.24.0",
    "@aws-amplify/backend-cli": "1.5.0",
    "@aws-sdk/client-cognito-identity-provider": "^3.1141.0",
    "@emnapi/core": "^1.11.3",
    "@emnapi/runtime": "^1.11.3",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/aws-lambda": "^8.10.163",
    "@types/node": "^26.0.0",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser": "^4.1.9",
    "aws-cdk-lib": "^2.260.0",
    "constructs": "^10.6.0",
    "esbuild": "^0.28.1",
    "eslint": "^10.5.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.7.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.22.4",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^8.1.0",
    "vitest": "^4.1.9"
  }
}
